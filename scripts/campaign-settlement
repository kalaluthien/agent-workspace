#!/usr/bin/env python3
"""Print the settlement of every subtask of a campaign anchor.

This is the observable the scenarios in spec/alloy/ are judged by. It reads GitHub only -- no terminal screen, no local directory -- so
it answers the same question from any machine, which is the point.

Verdicts match spec/alloy/ledger.als:
  complete  closed, and a pull request that closed it is merged
  dropped   closed, with no merged pull request behind it -- closed as "not
            planned", as a duplicate, or as completed with nothing to merge
  open      still open

Settled is "the issue is closed", both verdicts alike; the merged pull request
only says which kind. That is the reading spec/alloy/ledger.als pins and
AGENTS.md states, and this script is its one implementation -- a second reader
written by hand somewhere else is what drifts.

scripts/check-rule-readers is the second reader that keeps this claim true: it
refuses a commit that stages a read of `mergedAt` or `stateReason` as code in
any tracked markdown outside scripts/ -- inside a fence or a four-space indent,
reading the index rather than the working tree. It catches a pasted copy, not a
re-implementation that names nothing; see its header. Removing the guard
returns this line to being a hope.

The anchor repository also holds subtasks -- it is a member of its own
campaigns -- so the number handed in may be a subtask, and a subtask may be an
anchor. Neither is visible in a settlement table, so both are reported.

Those reports read labels and the parent relation, never the body. Body shape is
the second layer of the classification AGENTS.md states, and it is a person's
reading: prose is editable and the parent relation is not, so a script that
classified by prose would change its answer when somebody reflows a paragraph.

Usage: scripts/campaign-settlement <anchor-issue-number> [owner/repo]
"""
import json
import subprocess
from pathlib import Path
import sys

DEFAULT_ANCHOR_REPO = "kalaluthien/agent-workspace"
CAMPAIGN_LABEL = "campaign"


def gh(*args):
    out = subprocess.run(["gh", *args], capture_output=True, text=True)
    if out.returncode != 0:
        raise SystemExit(f"gh {' '.join(args)} failed:\n{out.stderr.strip()}")
    return json.loads(out.stdout) if out.stdout.strip() else None


def verdict(repo, number):
    """(verdict, note) for one subtask issue."""
    info = gh("issue", "view", str(number), "-R", repo,
              "--json", "state,stateReason,closedByPullRequestsReferences,title")
    if info["state"] == "OPEN":
        return "open", "", info["title"]
    for ref in info["closedByPullRequestsReferences"]:
        pr_repo = f"{ref['repository']['owner']['login']}/{ref['repository']['name']}"
        pr = gh("pr", "view", str(ref["number"]), "-R", pr_repo, "--json", "state")
        if pr["state"] == "MERGED":
            return "complete", ref["url"], info["title"]
    # The note says which kind of closed, because "dropped" alone reads as
    # abandoned and a completed subtask with nothing to merge lands here too.
    note = {"NOT_PLANNED": "not planned",
            "COMPLETED": "completed, no merged pull request",
            "DUPLICATE": "duplicate"}.get(info["stateReason"] or "",
                                          "closed, no reason recorded")
    return "dropped", note, info["title"]


def anchor_reports(head):
    """What says the number handed in is not an anchor. Costs no extra call."""
    if CAMPAIGN_LABEL not in [l["name"] for l in head["labels"]]:
        yield (f"REPORT: no `{CAMPAIGN_LABEL}` label, so this may be a subtask read"
               " as an anchor")
    if head["parent"]:
        yield (f"REPORT: this anchor is itself a sub-issue of #{head['parent']['number']}"
               " -- closing that campaign will not settle this one")


def read_index(repo, anchor):
    """The campaign's members, through the one script that owns that reading."""
    import importlib.machinery
    import importlib.util
    here = Path(__file__).resolve().parent
    spec = importlib.util.spec_from_loader(
        "campaign_subtasks",
        importlib.machinery.SourceFileLoader("campaign_subtasks",
                                             str(here / "campaign-subtasks")))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    r = subprocess.run(["gh", "api", "--paginate",
                        f"repos/{repo}/issues/{anchor}/sub_issues"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        return None, f"gh exited {r.returncode}: {r.stderr.strip()[:160]}"
    return mod.parse_index(r.stdout)


def main():
    if len(sys.argv) < 2:
        raise SystemExit(__doc__)
    anchor = sys.argv[1]
    anchor_repo = sys.argv[2] if len(sys.argv) > 2 else DEFAULT_ANCHOR_REPO

    head = gh("issue", "view", anchor, "-R", anchor_repo,
              "--json", "state,title,labels,parent")
    # One reader of the sub-issue index, and it is campaign-subtasks. This used
    # to carry a second one on a different pagination model (--slurp plus a
    # flatten), which is the drift AGENTS.md forbids two sections above where
    # it forbids it.
    subs, why = read_index(anchor_repo, anchor)
    if why:
        sys.exit(f"campaign-settlement: could not read the sub-issue index -- "
                 f"{why}\n  An index that did not read is not an empty campaign.")

    print(f"anchor {anchor_repo}#{anchor}  [{head['state']}]  {head['title']}")
    for line in anchor_reports(head):
        print(f"  -- {line}")
    if not subs:
        print("  (no sub-issues: the index is empty)")
        return

    rows, settled, nested = [], 0, []
    for s in subs:
        repo = "/".join(s["repository_url"].split("/")[-2:])
        v, note, title = verdict(repo, s["number"])
        settled += v != "open"
        rows.append((f"{repo}#{s['number']}", v, title[:44], note))
        # sub_issues is not recursive (probed), so a subtask that is itself an
        # anchor hides its own members from this table.
        if s["sub_issues_summary"]["total"]:
            nested.append((f"{repo}#{s['number']}", s["sub_issues_summary"]["total"]))

    width = max(len(r[0]) for r in rows)
    for ref, v, title, note in rows:
        print(f"  {ref:<{width}}  {v:<9} {title}" + (f"  [{note}]" if note else ""))

    for ref, total in nested:
        print(f"  -- REPORT: {ref} has {total} sub-issue(s) of its own, not listed"
              " above; run this on it too")

    closable = settled == len(rows)
    print(f"  -- {settled}/{len(rows)} settled; "
          + ("closable" if closable else "NOT closable: open subtasks remain"))
    if head["state"] == "CLOSED" and not closable:
        print("  -- REPORT: the anchor is closed with subtasks still open")


main()
