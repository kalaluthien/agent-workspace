#!/usr/bin/env python3
"""Which machine is this campaign bound to?

    scripts/campaign-bound <N> [<anchor-repo>]

The one reader of the `BOUND` comment. AGENTS.md § Who is a campaign session
makes that comment the authority on which machine may write a campaign, and
three gates turn on the answer: joining a campaign, writing its anchor, and
closing it -- the last of which deletes a tree.

    stdout              exit  meaning
    here                0     the latest BOUND names this machine
    elsewhere <name>    0     the latest BOUND names another machine
    unbound             0     the anchor carries no BOUND comment
    (stderr)            2     the reading itself failed

**Exit status is about the reading, never the verdict** -- the rule AGENTS.md
states for `campaign-local-work` and `campaign-session-alive`, for the same
reason: a failed read that exits like `unbound` invites a session to bind a
campaign another machine is working. So a caller compares the printed word and
treats anything else, exit 2 included, as a refusal. Only `here` licenses a
write, and `unbound` licenses asking the person, never binding on your own.

This exists because the reading was three copies of one jq pipeline in fenced
code blocks -- `AGENTS.md`, and both campaign skills -- with nothing owning it.
That is the shape #65 removed for the liveness test, where four prose copies of
one comparison were wrong together. Found by campaign-1-executor-1 while
sweeping for #75.

Four things the pipeline had to get right, and each is a way to be wrong:

  * `--paginate`. Comments page at thirty, and a truncated listing reads
    exactly like a complete one -- so a campaign migrated after thirty comments
    would answer with the binding it left.
  * Oldest first. REST returns comments in creation order, so the LAST match is
    the current binding. Taking the first returns the original binding forever,
    which is the migration bug in the other direction.
  * The first line only. A binding may be annotated -- a migration says there
    why -- so `tail -1` over whole bodies takes the last line of the prose
    rather than the binding (probed 2026-08-29).
  * `\r`. A body stored with CRLF leaves a trailing carriage return on the
    machine name, and a name compared with one attached matches nothing.

The comparison against this machine is folded in rather than left to the
caller, because every one of the three sites ran `hostname -s` as its next
line and compared by eye. A verdict a caller has to assemble is a verdict that
drifts one site at a time.
"""
import json
import subprocess
import sys

DEFAULT_ANCHOR_REPO = "kalaluthien/agent-workspace"
PREFIX = "BOUND "


def refuse(message):
    print(f"campaign-bound: {message}", file=sys.stderr)
    raise SystemExit(2)


def run(*args):
    try:
        out = subprocess.run(args, capture_output=True, text=True, check=False)
    except OSError as exc:
        refuse(f"cannot run {args[0]}: {exc}")
    if out.returncode != 0:
        refuse(f"{' '.join(args)} exited {out.returncode}: "
               f"{out.stderr.strip() or out.stdout.strip() or 'no message'}")
    return out.stdout


def bodies(repo, number):
    """Every comment body on the anchor, oldest first.

    `--paginate --slurp` is what makes one JSON document out of the pages; without
    `--slurp` gh concatenates one array per page and json.loads sees trailing data.
    """
    raw = run("gh", "api", "--paginate", "--slurp",
              f"repos/{repo}/issues/{number}/comments")
    try:
        pages = json.loads(raw)
    except json.JSONDecodeError as exc:
        refuse(f"gh returned something that is not JSON: {exc}")
    out = []
    for page in pages:
        if not isinstance(page, list):
            refuse("gh returned a shape this script does not know")
        out.extend(c.get("body") or "" for c in page)
    return out


def binding_of(comment_bodies):
    """The machine named by the last BOUND comment, or None. A calculation, so
    the three ways this can be wrong are testable without a network."""
    found = None
    for body in comment_bodies:
        if body.startswith(PREFIX):
            # The first line is the binding; anything after it is prose.
            found = body.split("\n", 1)[0][len(PREFIX):].strip()
    return found or None


def this_machine():
    name = run("hostname", "-s").strip()
    if not name:
        refuse("hostname -s printed nothing")
    return name


def main():
    argv = sys.argv[1:]
    if not 1 <= len(argv) <= 2:
        refuse("usage: campaign-bound <N> [<anchor-repo>]")
    number = argv[0].lstrip("#")
    if not number.isascii() or not number.isdigit() or int(number) <= 0:
        refuse(f"not an issue number: {argv[0]!r}")
    repo = argv[1] if len(argv) > 1 else DEFAULT_ANCHOR_REPO

    machine = binding_of(bodies(repo, number))
    if machine is None:
        print("unbound")
    elif machine == this_machine():
        print("here")
    else:
        print(f"elsewhere {machine}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
