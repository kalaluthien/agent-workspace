#!/usr/bin/env python3
"""Read a campaign's sub-issue index -- the whole of it, and say so.

`gh issue create --parent` is the only write that records a campaign's
membership, and this endpoint is the only read. AGENTS.md carried the command in
prose with `--paginate` and a sentence saying it is not optional; the endpoint
pages at thirty, and a truncated index reads exactly like a complete one to every
caller that matters -- including the close, which is the one place the index is
read before a directory is deleted.

WHAT IT PRINTS

One row per subtask: its repository, number, state, and title. Then the count.
An empty index is printed as an empty index, which is a reading; a failed request
is printed as a failure, which is not.

EXIT

0 when the index was read, 1 when it could not be.

Usage: scripts/campaign-subtasks <N> [--repo owner/repo]
"""
import argparse
import json
import subprocess
import sys

REPO = "kalaluthien/agent-workspace"


def parse_pages(text):
    """`gh api --paginate` concatenates one JSON array per page rather than
    returning one array, so `json.loads` sees trailing data and raises on any
    campaign with more than thirty subtasks -- the ones where reading the whole
    index matters. Returns (items, why_unreadable)."""
    items, decoder, i = [], json.JSONDecoder(), 0
    text = text.strip()
    try:
        while i < len(text):
            page, end = decoder.raw_decode(text, i)
            if not isinstance(page, list):
                return None, f"a page was {type(page).__name__}, not a list"
            items.extend(page)
            i = end
            while i < len(text) and text[i] in " \n\r\t":
                i += 1
    except ValueError as e:
        return None, (f"could not parse the index ({e.__class__.__name__}). "
                      f"An index that did not read is not an empty campaign.")
    return items, None


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("anchor")
    ap.add_argument("--repo", default=REPO)
    args = ap.parse_args()

    path = f"repos/{args.repo}/issues/{args.anchor}/sub_issues"
    try:
        r = subprocess.run(["gh", "api", "--paginate", path],
                           capture_output=True, text=True)
    except (FileNotFoundError, PermissionError) as e:
        print(f"campaign-subtasks: could not run gh ({e.__class__.__name__}).",
              file=sys.stderr)
        return 1
    print(f"read {path} --paginate")
    if r.returncode != 0:
        print(f"FAILED -- gh exited {r.returncode}: {r.stderr.strip()[:200]}\n"
              f"An index that did not read is not an empty campaign.",
              file=sys.stderr)
        return 1
    items, why = parse_pages(r.stdout)
    if why:
        print(f"FAILED -- {why}", file=sys.stderr)
        return 1

    for it in items:
        repo = (it.get("repository") or {}).get("full_name", "?")
        print(f"  {repo}#{it.get('number', '?'):<6} {it.get('state', '?'):<7} "
              f"{(it.get('title') or '')[:70]}")
    print(f"{len(items)} subtask(s)"
          + ("  (an empty index is a reading, not a failure)" if not items else ""))
    return 0


if __name__ == "__main__":
    sys.exit(main())
