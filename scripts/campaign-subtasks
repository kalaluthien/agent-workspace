#!/usr/bin/env python3
"""Read a campaign's sub-issue index -- the whole of it, and say so.

`gh issue create --parent` is the only write that records a campaign's
membership, and this endpoint is the only read. AGENTS.md carried the command in
prose with `--paginate` and a sentence saying it is not optional. The endpoint
pages at thirty, and a truncated index reads exactly like a complete one to every
caller that matters -- including the close, which is the one place the index is
read before a directory is deleted. Dropping the flag is the failure this owns.

WHAT IT PRINTS

One row per subtask: its repository, number, state, and title. Then the count.
An empty index is printed as an empty index, which is a reading; a failed request
is printed as a failure, which is not.

EXIT

0 when the index was read, 1 when it could not be.

Usage: scripts/campaign-subtasks <N> [--repo owner/repo]
"""
import argparse
import json
import subprocess
import sys

REPO = "kalaluthien/agent-workspace"


NOT_EMPTY = "An index that did not read is not an empty campaign."


def parse_index(text):
    """Returns (items, why_unreadable).

    `gh api --paginate` behaves by the response's own shape: an endpoint
    returning a JSON **array** has its pages merged into one array, while an
    object endpoint has its page objects concatenated and needs a streaming
    decode. This endpoint returns an array, so a plain decode is right."""
    text = text.strip()
    if not text:
        return [], None
    try:
        items = json.loads(text)
    except ValueError as e:
        return None, (f"could not parse the index ({e.__class__.__name__}: "
                      f"{str(e)[:60]})")
    if not isinstance(items, list):
        return None, (f"the endpoint returned {type(items).__name__}, not a "
                      f"list; --paginate concatenates object pages, so this "
                      f"needs a streaming decode rather than a plain one")
    return items, None


def fetch_index(repo, anchor):
    """Ask GitHub for a campaign's members. Returns (items, why_unreadable).

    The request and the parse are one call on purpose. Moving only the parse
    behind this script left `--paginate` hand-written in campaign-settlement,
    where deleting it turned a live campaign's verdict from "NOT closable" into
    "closable" with fourteen subtasks silently gone and nothing red -- and
    check-rule-readers does not scan scripts/, so nothing held that copy."""
    try:
        r = subprocess.run(["gh", "api", "--paginate",
                            f"repos/{repo}/issues/{anchor}/sub_issues"],
                           capture_output=True, text=True)
    except (FileNotFoundError, PermissionError) as e:
        return None, f"could not run gh ({e.__class__.__name__})"
    if r.returncode != 0:
        return None, f"gh exited {r.returncode}: {r.stderr.strip()[:200]}"
    return parse_index(r.stdout)


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("anchor")
    ap.add_argument("--repo", default=REPO)
    args = ap.parse_args()

    print(f"read repos/{args.repo}/issues/{args.anchor}/sub_issues --paginate")
    items, why = fetch_index(args.repo, args.anchor)
    if why:
        print(f"FAILED -- {why}. {NOT_EMPTY}", file=sys.stderr)
        return 1

    for it in items:
        repo = (it.get("repository") or {}).get("full_name", "?")
        print(f"  {repo}#{it.get('number', '?'):<6} {it.get('state', '?'):<7} "
              f"{(it.get('title') or '')[:70]}")
    print(f"{len(items)} subtask(s)"
          + ("  (an empty index is a reading, not a failure)" if not items else ""))
    return 0


if __name__ == "__main__":
    sys.exit(main())
