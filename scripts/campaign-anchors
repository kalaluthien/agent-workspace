#!/usr/bin/env python3
"""List this tracker's open campaign anchors, and say where its two readings disagree.

AGENTS.md's first routing question is whether an open campaign's Scope covers the
request, and answering it wrongly opens a second campaign over one scope. Two
readings identify an anchor and they cross-check each other: the hand-applied
`campaign` label, and the one property a subtask cannot have -- no parent. Both
were prose with a `gh` line beside them, so both were copy-pasted, and the
`--limit` on each was one paste away from being dropped.

WHY --limit MATTERS, AND WHY TRUNCATION IS REPORTED

`gh issue list` defaults to thirty, newest first, and anchors are the oldest
issues here. A tracker whose thirty newest are all subtasks returns no anchor and
looks clean. So the limit is raised -- and a listing that comes back *at* the
limit is reported as possibly truncated, because a count read from a paginating
tool is its page size until proven otherwise, and a truncated listing reads
exactly like a complete one.

WHAT IT PRINTS

One row per open anchor, then any disagreement between the two readings:

  labelled but has a parent   a subtask wearing the label. Say so rather than
                              joining it.
  no parent, not labelled     possibly an anchor whose label was forgotten, or
                              the third kind of issue this tracker holds. Read
                              its body against the anchor template; that reading
                              decides, not this listing.

EXIT

0 when both readings were made, whatever they found -- including finding no
anchors, which is a reading. 1 when either could not be made.

Usage: scripts/campaign-anchors [--repo owner/repo] [--limit N]
"""
import argparse
import json
import subprocess
import sys

REPO = "kalaluthien/agent-workspace"


def listing(repo, limit, *extra):
    cmd = ["gh", "issue", "list", "-R", repo, "--state", "open",
           "--limit", str(limit), "--json", "number,title,labels,parent", *extra]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True)
    except (FileNotFoundError, PermissionError) as e:
        return None, f"{e.__class__.__name__}: {e}"
    if r.returncode != 0:
        return None, f"gh exited {r.returncode}: {r.stderr.strip()[:160]}"
    try:
        return json.loads(r.stdout), None
    except ValueError as e:
        return None, f"could not parse gh's output ({e.__class__.__name__})"


def classify(labelled, allopen):
    """Cross the two readings. Returns (anchors, stray, bare).

    Pure, because the disagreement between the readings is the whole product and
    the listings that produce it need the network. An issue is an anchor when
    BOTH readings agree; the label alone and the parent relation alone each name
    a different way of being wrong, and neither is dropped."""
    parentless = {i["number"] for i in allopen if not i.get("parent")}
    lab = {i["number"] for i in labelled}
    anchors = [i for i in labelled if i["number"] in parentless]
    stray = [i for i in labelled if i["number"] not in parentless]
    bare = [i for i in allopen
            if i["number"] in parentless and i["number"] not in lab]
    return anchors, stray, bare


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--repo", default=REPO)
    ap.add_argument("--limit", type=int, default=200)
    args = ap.parse_args()

    labelled, why1 = listing(args.repo, args.limit, "--label", "campaign")
    allopen, why2 = listing(args.repo, args.limit)
    print(f"read {args.repo}, limit {args.limit}")
    for name, data, why in (("labelled `campaign`", labelled, why1),
                            ("every open issue", allopen, why2)):
        if why:
            print(f"  {name}: FAILED -- {why}", file=sys.stderr)
        else:
            note = "  (at the limit: may be TRUNCATED, raise --limit)" \
                if len(data) >= args.limit else ""
            print(f"  {name}: {len(data)} issue(s){note}")
    if why1 or why2:
        print("A reading that did not happen is not an empty tracker.",
              file=sys.stderr)
        return 1

    anchors, stray, bare = classify(labelled, allopen)
    print(f"\nopen anchors ({len(anchors)}) -- labelled, and with no parent")
    for i in sorted(anchors, key=lambda x: x["number"]):
        print(f"  #{i['number']:<5} {i['title'][:88]}")
    if not anchors:
        print("  (none: this is a reading, not a failed one)")

    if stray:
        print(f"\n!! labelled but has a parent ({len(stray)}) -- a subtask "
              f"wearing the label; say so rather than joining it")
        for i in stray:
            print(f"  #{i['number']:<5} {i['title'][:88]}")

    if bare:
        print(f"\n!! no parent and not labelled ({len(bare)}) -- an anchor whose "
              f"label was forgotten, or the third\n   kind of issue this tracker "
              f"holds. Read the body against the anchor template; that\n   "
              f"reading decides, not this listing.")
        for i in bare:
            print(f"  #{i['number']:<5} {i['title'][:88]}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
