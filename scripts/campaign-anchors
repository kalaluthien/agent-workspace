#!/usr/bin/env python3
"""List this tracker's open campaign anchors, and say where its two readings disagree.

AGENTS.md's first routing question is whether an open campaign's Scope covers the
request, and answering it wrongly opens a second campaign over one scope. Two
readings identify an anchor and they cross-check each other: the hand-applied
`campaign` label, and the one property a subtask cannot have -- no parent.

BOTH READINGS COME FROM ONE LISTING

An earlier version made two `gh` calls -- one filtered by label, one unfiltered --
and inferred a property from *absence* in the other. Absence is not evidence: a
truncated listing, or an issue created between the two calls, denounced a real
anchor as a subtask wearing the label, and a caller reading "no campaign covers
this" opens the duplicate this script exists to prevent. One listing carrying
`labels` and `parent` gives both readings off the same snapshot, so there is no
cross-call inference left to be wrong.

WHY --limit MATTERS, AND WHY AT-THE-LIMIT REFUSES

`gh issue list` defaults to thirty, newest first, and anchors are the oldest
issues here. A tracker whose thirty newest are all subtasks returns no anchor and
looks clean. So the limit is raised -- and a listing that comes back *at* the
limit refuses rather than printing, because a capped listing is a reading not
made in full and the rows below it would be wrong rather than merely short.

WHAT IT PRINTS

One row per open anchor -- labelled and parentless -- then the two ways the
readings disagree:

  labelled but has a parent   a subtask wearing the label. Say so rather than
                              joining it.
  no parent, not labelled     possibly an anchor whose label was forgotten, or
                              the third kind of issue this tracker holds. Read
                              its body against the anchor template; that reading
                              decides, not this listing.

An issue with a parent and no label is an ordinary subtask and is not reported.

EXIT

0 when the listing was read and was not capped. 1 when it could not be read, or
came back at the limit -- both are readings not made, and neither is an empty
tracker.

Usage: scripts/campaign-anchors [--repo owner/repo] [--limit N]
"""
import argparse
import json
import subprocess
import sys

REPO = "kalaluthien/agent-workspace"


def listing(repo, limit):
    cmd = ["gh", "issue", "list", "-R", repo, "--state", "open",
           "--limit", str(limit), "--json", "number,title,labels,parent"]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True)
    except (FileNotFoundError, PermissionError) as e:
        return None, f"{e.__class__.__name__}: {e}"
    if r.returncode != 0:
        return None, f"gh exited {r.returncode}: {r.stderr.strip()[:160]}"
    try:
        data = json.loads(r.stdout)
    except ValueError as e:
        return None, f"could not parse gh's output ({e.__class__.__name__})"
    if not isinstance(data, list):
        return None, f"gh returned {type(data).__name__}, not a list of issues"
    return data, None


def classify(issues):
    """Split one listing by its two readings. Returns (anchors, stray, bare).

    Every issue carries both properties, so each row is decided by what that
    issue itself says -- never by its absence from somewhere else."""
    def labelled(i):
        return any(l.get("name") == "campaign" for l in i.get("labels") or [])
    anchors = [i for i in issues if labelled(i) and not i.get("parent")]
    stray = [i for i in issues if labelled(i) and i.get("parent")]
    bare = [i for i in issues if not labelled(i) and not i.get("parent")]
    return anchors, stray, bare


def rows(title, items, note=""):
    print(f"\n{title} ({len(items)})" + (f" -- {note}" if note else ""))
    for i in sorted(items, key=lambda x: x["number"]):
        print(f"  #{i['number']:<5} {i['title'][:88]}")


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--repo", default=REPO)
    ap.add_argument("--limit", type=int, default=200)
    args = ap.parse_args()

    issues, why = listing(args.repo, args.limit)
    if why:
        print(f"campaign-anchors: could not read {args.repo} -- {why}\n"
              f"  A reading that did not happen is not an empty tracker.",
              file=sys.stderr)
        return 1
    print(f"read {args.repo}, limit {args.limit}: {len(issues)} open issue(s)")
    if len(issues) >= args.limit:
        print(f"REFUSING: the listing came back at --limit {args.limit}, so it "
              f"may be truncated,\n  and a truncated listing reads exactly like "
              f"a complete one. Raise --limit and re-run.", file=sys.stderr)
        return 1

    anchors, stray, bare = classify(issues)
    rows("open anchors", anchors, "labelled `campaign`, and with no parent")
    if not anchors:
        print("  (none: this is a reading, not a failed one)")
    if stray:
        rows("!! labelled but has a parent", stray,
             "a subtask wearing the label; say so rather than joining it")
    if bare:
        rows("!! no parent and not labelled", bare,
             "an anchor whose label was forgotten, or the third kind of issue "
             "this\n   tracker holds. Read the body against the anchor template")
    return 0


if __name__ == "__main__":
    sys.exit(main())
