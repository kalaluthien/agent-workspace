#!/usr/bin/env python3
"""Print what this repository can decide by machine, so a session knows it exists.

#105 moves rules out of AGENTS.md and into hooks and scripts. That trade only
works if a session can still find them: a rule deleted from the prose and buried
in a script nobody knows about is not mechanised, it is lost. This is the
announcement, and a SessionStart hook runs it.

It is derived, never a hand-kept list -- a second copy of the inventory would
drift exactly the way the prose copies this campaign is deleting drifted. Two
facts already in the tree carry it: every script states its purpose on the line
under its shebang, and install-hooks names which of them git runs on its own. So
adding a script changes this output with no second edit anywhere.

A script it cannot read, or one whose kind it cannot tell, is printed as such.
An inventory that silently omits a primitive is worse than none: it reads as a
complete list, and the reader concludes the thing is not there.

Usage: scripts/campaign-primitives [--brief]
"""
import re
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent

# How each language in this tree opens a comment. A summary must be one.
MARKERS = ('"""', "'''", "#", "//", "--")


def summary(path):
    """The line under the shebang, however the language spells a comment.

    It must *be* a comment or a docstring. The first draft took the first line
    that was not a shebang or an obvious keyword, so a script with no summary at
    all was announced with a line of its own code -- `echo hi` presented to a
    reader as what the script answers. A wrong description is worse than a
    missing one, because the missing one is reported.

    None when there is nothing to read, and an `<unreadable: ...>` marker when
    the file could not be opened. Both are reported by the caller; neither is
    silently dropped."""
    try:
        lines = path.read_text().splitlines()
    except (OSError, UnicodeDecodeError) as e:
        return f"<unreadable: {e.__class__.__name__}>"
    for line in lines[1:8]:
        stripped = line.strip()
        for marker in MARKERS:
            if stripped.startswith(marker):
                text = stripped[len(marker):].strip().strip('"').strip()
                if text:
                    return text
                break
    return None


def installed_hooks(src):
    """Which git hooks install-hooks writes, from its own `hook=$hookdir/<name>`
    assignments. Pure, so it can be tested against a recorded file."""
    return sorted(set(re.findall(r"^hook=\$hookdir/([a-z-]+)", src, re.M)))


def hook_run(src, names):
    """Which of these scripts git runs unasked.

    A script's name appearing anywhere in install-hooks is the test, rather than
    parsing the loop that happens to list them today. The first draft matched
    `for guard in ...` only, so an ordinary shell refactor -- unrolling the
    loop, or moving the names into a variable -- silently reclassified both
    guards as things a flow has to call, which is the opposite of what they are.
    """
    # install-hooks names itself in its own help text, and it is the installer
    # rather than something git runs -- so it is excluded by name, which is the
    # one special case this test needs and says so here rather than anywhere
    # else.
    return {n for n in names if n != "install-hooks" and n in src}


def main():
    brief = "--brief" in sys.argv
    try:
        src = (HERE / "install-hooks").read_text()
    except OSError as e:
        print(f"!! could not read install-hooks ({e.__class__.__name__}), so "
              f"nothing below can be\n   classified as run-by-git. Treat the "
              f"whole listing as unverified.")
        src = ""
    scripts = [p for p in sorted(HERE.iterdir())
               if not p.is_dir() and not p.name.endswith("-test")
               and p.stat().st_mode & 0o111]
    runs = hook_run(src, {p.name for p in scripts})
    hooks = installed_hooks(src)
    guards, readers, unknown = [], [], []
    for p in scripts:
        s = summary(p)
        if s is None or s.startswith("<unreadable"):
            unknown.append((p.name, s or "<no summary line under the shebang>"))
        elif p.name in runs:
            guards.append((p.name, s))
        else:
            readers.append((p.name, s))

    if src and not runs:
        print("!! install-hooks names none of these scripts, so the split "
              "below is not real:")
        print("   everything is listed as a reader. Read install-hooks before "
              "believing it.")

    print("Machine-decided here. Ask these before writing a check by hand.")
    # The hooks themselves, not only the scripts they call. The push hook calls
    # no script, so a listing built from script names alone left the one
    # mechanism that acts on every commit entirely unannounced.
    if hooks:
        print(f"\n  git hooks installed by scripts/install-hooks "
              f"({len(hooks)}): {', '.join(hooks)}")
    else:
        print("\n  !! no git hook could be read out of install-hooks.")
    print(f"\n  git runs these on its own ({len(guards)}):")
    for n, s in guards:
        print(f"    {n:24} {s}")
    print(f"\n  a flow calls these ({len(readers)}):")
    if brief:
        # Every session start pays for this, so the brief form spends its lines
        # on the guards -- which act unasked -- and names the rest, since a
        # name is enough to go and read one.
        line, out = "   ", []
        for n, _ in readers:
            if len(line) + len(n) > 76:
                out.append(line)
                line = "   "
            line += " " + n
        out.append(line)
        print("\n".join(out))
        print("\n  scripts/campaign-primitives says what each one answers.")
    else:
        for n, s in readers:
            print(f"    {n:24} {s}")
    if unknown:
        print(f"\n  !! {len(unknown)} could not be classified:")
        for n, why in unknown:
            print(f"    {n:24} {why}")
    return 1 if unknown else 0


if __name__ == "__main__":
    sys.exit(main())
