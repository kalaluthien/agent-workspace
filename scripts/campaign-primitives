#!/usr/bin/env python3
"""Print what this repository can decide by machine, so a session knows it exists.

#105 moves rules out of AGENTS.md and into hooks and scripts. That trade only
works if a session can still find them: a rule deleted from the prose and buried
in a script nobody knows about is not mechanised, it is lost. This is the
announcement, and a SessionStart hook runs it.

It is derived, never a hand-kept list -- a second copy of the inventory would
drift exactly the way the prose copies this campaign is deleting drifted. Two
facts already in the tree carry it: every script states its purpose on the line
under its shebang, and install-hooks names which of them git runs on its own. So
adding a script changes this output with no second edit anywhere.

A script it cannot read, or one whose kind it cannot tell, is printed as such.
An inventory that silently omits a primitive is worse than none: it reads as a
complete list, and the reader concludes the thing is not there.

Usage: scripts/campaign-primitives [--brief]
"""
import re
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent

# How each language in this tree opens a comment. A summary must be one.
MARKERS = ('"""', "'''", "#", "//", "--")


def summary(path):
    """The line under the shebang, however the language spells a comment.

    It must *be* a comment or a docstring. The first draft took the first line
    that was not a shebang or an obvious keyword, so a script with no summary at
    all was announced with a line of its own code -- `echo hi` presented to a
    reader as what the script answers. A wrong description is worse than a
    missing one, because the missing one is reported.

    None when there is nothing to read, and an `<unreadable: ...>` marker when
    the file could not be opened. Both are reported by the caller; neither is
    silently dropped."""
    try:
        lines = path.read_text().splitlines()
    except (OSError, UnicodeDecodeError) as e:
        return f"<unreadable: {e.__class__.__name__}>"
    for line in lines[1:8]:
        stripped = line.strip()
        for marker in MARKERS:
            if stripped.startswith(marker):
                text = stripped[len(marker):].strip().strip('"').strip()
                if text:
                    return text
                break
    return None


def hooks_dir():
    """Where git actually looks for hooks in this checkout. Returns
    (path, why_unreadable)."""
    r = subprocess.run(["git", "rev-parse", "--path-format=absolute",
                        "--git-common-dir"], capture_output=True, text=True)
    if r.returncode != 0:
        return None, f"git rev-parse failed: {r.stderr.strip()[:100]}"
    return Path(r.stdout.strip()) / "hooks", None


def installed_hooks(hdir):
    """The hook files git will run, with their text. Reality, not intent.

    Reading install-hooks instead was wrong twice over. Keyed on its guard loop,
    an ordinary shell refactor reclassified both guards; keyed on a script's
    name appearing anywhere in it, the header prose naming both guards made the
    inventory report them as installed *after the entire loop was deleted* --
    the failure that matters, because it tells a reader the tree is guarded when
    nothing guards it. What git will run is a fact about this checkout, and it
    is the question a session is actually asking.
    """
    out = {}
    if hdir is None or not hdir.is_dir():
        return out
    for p in sorted(hdir.iterdir()):
        if p.suffix == ".sample" or not p.is_file():
            continue
        if not p.stat().st_mode & 0o111:
            continue
        try:
            out[p.name] = p.read_text()
        except (OSError, UnicodeDecodeError) as e:
            out[p.name] = f"<unreadable: {e.__class__.__name__}>"
    return out


def hook_run(hook_texts, names):
    """Which scripts the installed hooks declare they run.

    Read from each hook's own `# runs:` line, which is also the list the hook
    loops over -- one list, two readers, and no parsing of shell on this side.
    Three earlier attempts failed on the same axis: scraping the loop broke
    under an ordinary refactor, and matching a script's name anywhere in
    install-hooks matched its header prose, so the inventory reported both
    guards as installed after the whole loop had been deleted. That is the
    failure that matters -- it tells a reader the tree is guarded when nothing
    guards it. A declaration the hook itself consumes cannot say something the
    hook does not do.

    Returns (found, problems). A hook with no `# runs:` line is named, not
    passed over: a hook this cannot read is not a hook that runs nothing.
    """
    found, problems = set(), []
    for name, text in sorted(hook_texts.items()):
        declared = re.findall(r"^# runs: (.+)$", text, re.M)
        if not declared:
            problems.append(f"{name} declares no `# runs:` line, so what it "
                            f"runs is unknown")
            continue
        for word in " ".join(declared).split():
            if word in names:
                found.add(word)
            else:
                problems.append(f"{name} declares {word}, which is not a "
                                f"script in this checkout")
    return found, problems


def main():
    brief = "--brief" in sys.argv
    # Which scripts to describe. Defaults to this script's own directory; named
    # so another checkout can be listed, and so the unclassifiable case has a
    # case at all -- it cannot be reached by planting a broken script in the
    # real scripts/.
    here = HERE
    if "--scripts-dir" in sys.argv:
        here = Path(sys.argv[sys.argv.index("--scripts-dir") + 1])
    hdir, why = hooks_dir()
    hook_texts = installed_hooks(hdir)
    scripts = [p for p in sorted(here.iterdir())
               if not p.is_dir() and not p.name.endswith("-test")
               and p.stat().st_mode & 0o111]
    runs, problems = hook_run(hook_texts, {p.name for p in scripts})
    guards, readers, unknown = [], [], []
    for p in scripts:
        summ = summary(p)
        if summ is None or summ.startswith("<unreadable"):
            unknown.append((p.name, summ or "<no comment under the shebang>"))
        elif p.name in runs:
            guards.append((p.name, summ))
        else:
            readers.append((p.name, summ))

    print("Machine-decided here. Ask these before writing a check by hand.")

    if why:
        print(f"\n  !! could not find this checkout's hooks ({why}), so nothing "
              f"below is\n     known to run on its own.")
    elif not hook_texts:
        print(f"\n  !! NO git hook is installed in {hdir}. Nothing in this "
              f"checkout is guarded.\n     Run scripts/install-hooks.")
    else:
        print(f"\n  git hooks installed ({len(hook_texts)}): "
              f"{', '.join(sorted(hook_texts))}")
        for w in problems:
            print(f"     !! {w}")
        if not runs:
            print("     !! no hook declares a script named below, so nothing "
                  "in this checkout is\n        known to be guarded.")

    print(f"\n  run by a git hook, unasked ({len(guards)}):")
    for n, summ in guards:
        print(f"    {n:24} {summ}")
    print(f"\n  a flow calls these ({len(readers)}):")
    if brief:
        # Every session start pays for this, so the brief form spends its lines
        # on what acts unasked and names the rest -- a name is enough to go and
        # read one.
        line, out = "   ", []
        for n, _ in readers:
            if len(line) + len(n) > 76:
                out.append(line)
                line = "   "
            line += " " + n
        out.append(line)
        print("\n".join(out))
        print("\n  scripts/campaign-primitives says what each one answers.")
    else:
        for n, summ in readers:
            print(f"    {n:24} {summ}")
    if unknown:
        print(f"\n  !! {len(unknown)} could not be classified:")
        for n, w in unknown:
            print(f"    {n:24} {w}")

    # Always 0. This is the SessionStart hook's command, and a non-zero exit
    # there is a non-blocking error: stderr surfaces and stdout is dropped. So
    # exiting 1 on an unclassifiable script suppressed the entire announcement
    # -- the one case the `!!` block exists for. The block is the report; the
    # status is not.
    return 0


if __name__ == "__main__":
    sys.exit(main())
