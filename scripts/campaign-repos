#!/usr/bin/env python3
"""Read the `## Repos` list of a campaign README or anchor issue body.

    scripts/campaign-repos <path>

Prints one `owner/repo` per line, in the order the list has them. A campaign
with no member repository writes `- none` as the whole list, and for that list
this prints nothing and exits 0 -- so a caller loops over the output and needs
no special case of its own.

Exits 1 with one line on stderr for the four ways the list is wrong: no
`## Repos` heading, an empty list, a `<` placeholder, and `- none` mixed with
repository entries. Why each of those is refused, and the retirement rule the
last one enforces, is stated once in AGENTS.md (see "Running a campaign"); this
is the reader that makes it true.

This is the ONE reader of that list. opening-campaign step 5, closing-campaign
step 4 and the passage on adding a repository mid-campaign all call it, for the
reason AGENTS.md gives about scripts/campaign-settlement: two readers of one
list drift, and this list is the campaign's repository index.
"""
import re
import sys

HEADING = re.compile(r"^## Repos\s*$")
NEXT_SECTION = re.compile(r"^## ")


def entries(text):
    """The `- ` items under `## Repos`, or None when there is no such heading."""
    out, inside = [], False
    for line in text.splitlines():
        if HEADING.match(line):
            inside = True
            continue
        if inside:
            if NEXT_SECTION.match(line):
                break
            if line.startswith("- "):
                out.append(line[2:].strip())
    return out if inside else None


def main():
    if len(sys.argv) != 2:
        raise SystemExit(__doc__)
    path = sys.argv[1]
    try:
        with open(path, encoding="utf-8") as f:
            items = entries(f.read())
    except OSError as e:
        sys.exit(f"campaign-repos: cannot read {path}: {e.strerror}")

    if items is None:
        sys.exit(f"campaign-repos: no `## Repos` heading in {path}")
    if not items:
        sys.exit(f"campaign-repos: the ## Repos list is empty in {path}")

    bad = [i for i in items if "<" in i]
    if bad:
        sys.exit(f"campaign-repos: placeholders survive in ## Repos: {bad[0]}")

    # Case-folded, because `- None` reaching acquire-repo as a repository name
    # is the failure the sentinel exists to prevent.
    repos = [i for i in items if i.casefold() != "none"]
    if len(repos) != len(items):
        if repos:
            plural = "y" if len(repos) == 1 else "ies"
            sys.exit(f"campaign-repos: `- none` is mixed with {len(repos)} repository"
                     f" entr{plural}; the list is `- none` alone or repositories,"
                     " never both")
        return                     # `- none` alone: no repositories, and that is fine

    print("\n".join(repos))


main()
