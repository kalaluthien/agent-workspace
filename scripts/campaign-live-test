#!/usr/bin/env python3
"""Prove campaign-live joins on the durable key and refuses a half-made reading.

The herdr half is tested against a recorded listing rather than whatever is
running, so the cases mean the same thing tomorrow. The directory half runs the
shipped script.

Usage: scripts/campaign-live-test
"""
import importlib.machinery
import importlib.util
import json
import subprocess
import sys
import tempfile
from pathlib import Path

LIVE = Path(__file__).resolve().parent / "campaign-live"


def load():
    spec = importlib.util.spec_from_loader(
        "campaign_live",
        importlib.machinery.SourceFileLoader("campaign_live", str(LIVE)))
    m = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m)
    return m


def agent(sid, name=None, pane="w1:p1"):
    a = {"agent_session": {"value": sid} if sid else None,
         "agent_status": "working", "cwd": "/x", "pane_id": pane}
    if name:
        a["name"] = name
    return a


def listing(*agents):
    return json.dumps({"result": {"agents": list(agents)}})


def main():
    m = load()
    fails = []

    ran = []

    def check(name, cond):
        # Counted as it runs. `total` was a constant, so deleting a case still
        # printed the same "13/13 pass" -- a suite that cannot report its own
        # shrinkage.
        ran.append(name)
        if not cond:
            fails.append(name)

    got, why = m.parse_agents(listing(agent("S1", "campaign-1-executor-1")))
    check("a listed session is keyed by its session id", why is None and "S1" in got)
    check("its name comes along", got and got["S1"]["name"] == "campaign-1-executor-1")

    got, why = m.parse_agents(listing(agent("S1")))
    check("a session with no name is still listed", why is None and got["S1"]["name"] == "<unnamed>")

    # The row the first draft dropped. A session herdr cannot identify still
    # occupies a pane, and dropping it shrinks the count a close gate reads.
    got, why = m.parse_agents(listing(agent(None, pane="w1:p9")))
    key = next(iter(got)) if got else ""
    check("a session herdr cannot identify is counted under a key naming its pane",
          why is None and len(got) == 1 and isinstance(key, str) and "w1:p9" in key)

    # The join, which is the whole point and which no case reached until a
    # mutation run showed that swapping the key for the name failed nothing.
    sessions, _ = m.parse_agents(listing(agent("S1", "campaign-1-executor-1")))
    same = {"7": {"session": "S1", "name": "campaign-1-executor-1", "branch": "b"}}
    a, o, i = m.classify(same, sessions)
    check("a claim whose session id is live is answered", len(a) == 1 and not o)
    # ...and is not also counted as holding nothing. The two lists are a
    # partition of the live sessions, and a session appearing on both would be
    # read by a close as one live executor too many.
    check("a session that answers a claim is not also listed as unattributed",
          not i)

    # The case that separates the two possible keys. The name matches and the
    # session id does not, which is exactly what a rename leaves behind: joining
    # on the name calls this answered, and a close then reads a live claim as
    # attributed to a session that is not the one holding it.
    renamed = {"7": {"session": "S9", "name": "campaign-1-executor-1", "branch": "b"}}
    a, o, i = m.classify(renamed, sessions)
    check("a claim whose name matches but session id does not is unanswered",
          not a and len(o) == 1)
    check("...and that live session is then reported as holding no claim", len(i) == 1)

    # The anchor argument, which used to be declared and never read.
    mine = {"7": {"session": "S1", "branch": "campaign-1/7-x"}}
    theirs = {"9": {"session": "S2", "branch": "campaign-2/9-y"}}
    check("a record naming this campaign's branch is not stray",
          m.stray_branches(mine, "1") == [])
    check("a record naming another campaign's branch is stray",
          len(m.stray_branches(theirs, "1")) == 1)
    check("a record with no branch cannot vouch for itself and is stray",
          len(m.stray_branches({"7": {"session": "S1"}}, "1")) == 1)
    check("anchor 1 does not swallow anchor 11",
          len(m.stray_branches({"7": {"branch": "campaign-11/7-x"}}, "1")) == 1)

    got, why = m.parse_agents("not json")
    check("unparseable output is a why, not an empty listing", got is None and why)
    got, why = m.parse_agents(json.dumps({"result": {}}))
    check("a listing with no agents key is a why, not zero sessions", got is None and why)

    # A reading that did not happen must not come back as a clean tree.
    with tempfile.TemporaryDirectory() as d:
        r = subprocess.run([sys.executable, str(LIVE), "1", "--dir", d],
                           capture_output=True, text=True)
        out = r.stdout + r.stderr
    check("a missing claims directory refuses", r.returncode == 1
          and "says nothing" in out)

    with tempfile.TemporaryDirectory() as d:
        (Path(d) / "runtime" / "claims").mkdir(parents=True)
        r = subprocess.run([sys.executable, str(LIVE), "1", "--dir", d],
                           capture_output=True, text=True)
        out = r.stdout + r.stderr
    check("an empty claims directory is read, not refused",
          r.returncode == 0 and "0 claim(s)" in out)
    check("and it still says both readings were made", "both readings were made" in out)

    # A run that asserted nothing is not a pass either.
    # The wire from main() into stray_branches, which the pure cases above
    # cannot reach: replacing the call with [] left the suite green. Run with
    # PATH stripped so herdr cannot be found -- the stray report must not
    # depend on the other reading having worked.
    with tempfile.TemporaryDirectory() as d:
        claims = Path(d) / "runtime" / "claims"
        claims.mkdir(parents=True)
        (claims / "9").write_text("session S9\nbranch campaign-2/9-y\n")
        r = subprocess.run([sys.executable, str(LIVE), "1", "--dir", d],
                           capture_output=True, text=True,
                           env={"PATH": "/nonexistent"})
        out = r.stdout + r.stderr
    check("a record from another campaign is reported by the real run",
          "campaign-2/9-y" in out and "outside campaign-1" in out)
    check("...even when the herdr reading could not be made",
          "did not happen" in out and r.returncode == 1)

    # A record that will not decode. It is a check that did not happen, so it
    # must deny the clean verdict the way a failed herdr read does -- the first
    # fix for this filed it as a cosmetic note and still printed "both readings
    # were made", which is this script's contract inverted.
    with tempfile.TemporaryDirectory() as d:
        claims = Path(d) / "runtime" / "claims"
        claims.mkdir(parents=True)
        (claims / "7").write_text("session S1\nbranch campaign-1/7-x\n")
        (claims / "9").write_bytes(b"\xff\xfe not text\n")
        r = subprocess.run([sys.executable, str(LIVE), "1", "--dir", d],
                           capture_output=True, text=True)
        out = r.stdout + r.stderr
    check("an unreadable record denies the clean verdict", r.returncode == 1)
    check("...and is named as unread rather than as a stray file",
          "will not decode" in out and "1 unread" in out)
    check("...and the run does not claim both readings were made",
          "both readings were made" not in out)

    # A non-file entry under claims/ is counted, not silently dropped.
    with tempfile.TemporaryDirectory() as d:
        claims = Path(d) / "runtime" / "claims"
        claims.mkdir(parents=True)
        (claims / "7").write_text("session S1\nbranch campaign-1/7-x\n")
        (claims / "9").mkdir()
        recs, odd = m.claim_records(claims)
        check("a directory under claims/ is named, not dropped",
              len(recs) == 1 and len(odd) == 1 and odd[0].startswith("9 "))

    if not ran:
        print("FAIL  the suite ran no case at all")
        return 1
    for f in fails:
        print(f"FAIL  {f}")
    print(f"{len(ran) - len(fails)}/{len(ran)} cases pass")
    return 1 if fails else 0


if __name__ == "__main__":
    sys.exit(main())
